+        lwc1    f22,JbFltF22(a0)        //
+        lwc1    f23,JbFltF23(a0)        //
+        lwc1    f24,JbFltF24(a0)        //
+        lwc1    f25,JbFltF25(a0)        //
+        lwc1    f26,JbFltF26(a0)        //
+        lwc1    f27,JbFltF27(a0)        //
+        lwc1    f28,JbFltF28(a0)        //
+        lwc1    f29,JbFltF29(a0)        //
+        lwc1    f30,JbFltF30(a0)        //
+        lwc1    f31,JbFltF31(a0)        //
+
+#else
+
=1 86 6
