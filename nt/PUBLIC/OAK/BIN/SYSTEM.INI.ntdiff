#ntdiff PUBLIC/OAK/BIN/SYSTEM.INI
#crlf
=1 1 14
+#if defined(_DECSTATION_)
+#define _HIVE_DECSTATION_
=1 14 2
+#endif // defined(_DECSTATION_)
=1 16 159
+// The DECstation 5000/200 (the KN02 system module): its SCSI controller is
+// the NCR 53C94 of TURBOchannel slot 5 (the Ncr53c9x miniport) and its
+// display the PMAG-BA color frame buffer of TURBOchannel slot 0 (the Pmagba
+// miniport), without the PC peripherals.  Its keyboard is the LK201 on line
+// 0 of the DZ serial line multiplexer of the system module and its mouse
+// the VSXXX on line 1: the Lk201 keyboard port driver and the Vsxxx pointer
+// port driver, clients of the Dzport port driver of the multiplexer.
+//
+
+#ifdef _HIVE_DECSTATION_
+#define DECSTATION 1
+#define NCR53C9X 1
+#define PMAGBA 1
=1 116 3
+#define CDFS 1
+#endif // _HIVE_DECSTATION_
=1 173 1034
=1 1220 136
+#elif defined(_HIVE_DECSTATION_)
+            //
+            // The R3000 port: no network yet.  The developer's first run keeps
+            // the domain of the machine in the Parameters of LanmanWorkstation:
+            // winlogon writes Domain and AccountDomainId there from registry.ini
+            // and the LSA's database install reads them (the account domain).
+            //
+            LanmanWorkstation
