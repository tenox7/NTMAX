+                    //
+                    // The network controller of the 5000/200, the PMAD-AA
+                    // of TURBOchannel slot 6: card type 4 (DECTC), as the
+                    // setup of the network card writes it.  The driver
+                    // takes the memory and the interrupt of the controller
+                    // from the hardware description of the firmware.
+                    //
=1 3042 1
+                    BusType = REG_DWORD 0x00000004
=1 3039 1
+                    CardType = REG_DWORD 0x00000004
+                    //
+                    // TCP/IP on the controller, with the address, the network,
+                    // the gateway and the name server that DHCP gives it (the
+                    // NAT of the emulator gives its machine 10.0.0.1 of the
+                    // network 10.0.0.0/8, whose gateway and name server are
+                    // 10.0.0.254).
+                    //
+                    Tcpip
+                        EnableDHCP = REG_DWORD 0x00000001
+                        IPAddress = REG_MULTI_SZ "0.0.0.0"
+                        SubnetMask = REG_MULTI_SZ "0.0.0.0"
+                        DefaultGateway = REG_MULTI_SZ 
+                        UseZeroBroadcast = REG_DWORD 0x00000000
+                        LLInterface = 
+#endif // defined(_HIVE_DECSTATION_)
