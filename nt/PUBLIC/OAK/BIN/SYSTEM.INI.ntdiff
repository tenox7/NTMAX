+#if defined(_HIVE_DECSTATION_)
+            //
+            // The network as the network setup of NT 3.5 installs it on the
+            // controller (adapter Lance01): TCP/IP with DHCP and NetBIOS over
+            // TCP/IP (OEMNXPTC.INF), Windows Sockets, the NetBIOS interface and
+            // the services of LAN Manager (NTLANMAN.INF): workstation, server,
+            // browser, messenger, alerter, netlogon, directory replicator, the
+            // LmHosts service of NetBIOS over TCP/IP, the NT LM security support
+            // provider and the RPC services, bound as the network control panel
+            // binds them.  Without the Route values of the bindings, whose
+            // strings hold quotes, which REGINI cannot write, and, as in the
+            // network of the developer hives, without the Security values of
+            // the services: the service controller gives them its default.
+            //
