+            // and gethostbyname through it): TCP/IP, with the host file, the
+            // DNS and the NetBIOS names of wsock32.
+            //
+            ServiceProvider
+                Order
+                    ExcludedProviders = REG_MULTI_SZ ""
+                    ProviderOrder = REG_MULTI_SZ "Tcpip"
+#endif // defined(_HIVE_DECSTATION_)
