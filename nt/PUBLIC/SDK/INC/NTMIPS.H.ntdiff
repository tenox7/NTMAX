=1 661 5
+    ULONG filler1 : 6;
=1 671 2
=1 666 3
=2 666 1
=2 673 4
+// Define R3000 macro to initialize page directory table base.
=1 677 3
+     *((PULONG)(dirbase)) = 0; \
=1 680 3
+     ((HARDWARE_PTE *)(dirbase))->Dirty = 1
=1 704 6
+    ULONG X1 : 6;
+    ULONG PID : 6;
+    ULONG VPN : 20;
=1 713 7
+    ULONG IEC : 1;
+    ULONG KUC : 1;
+    ULONG IEP : 1;
+    ULONG KUP : 1;
+    ULONG IEO : 1;
+    ULONG KUO : 1;
+    ULONG X1 : 2;
