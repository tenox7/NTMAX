+VOID
+LanceZeroHardwareMemory(
=1 170 1
+    IN PVOID Destination,
+    IN UINT Length,
+    IN BOOLEAN Buffer
=1 262 6
+    This routine zeros memory of the adapter: descriptors or the
+    initialization block, or the data of a buffer.  The memory of the
+    LANCE of the system slot of a DECstation is zeroed a piece at a time,
+    each piece the part of a word, or of 16 bytes of a buffer, that is in
+    one place of its window (see lancehrd.h).
=1 272 3
+    Adapter - The adapter of the memory.
+
+    Destination - The address of the memory, as the driver keeps it.
+
+    Length - The number of bytes to zero.
+
+    Buffer - TRUE if the memory is the data of a buffer.
=1 1773 8
+    PUCHAR Address = (PUCHAR)Destination;
+    UINT Piece;
+
+    if (Adapter->LanceCard != LANCE_DECST) {
+
+        NdisZeroMappedMemory(Destination, Length);
=1 1854 5
+    while (Length != 0) {
+
+        if (Buffer) {
+
+            Piece = 16 - (LANCE_DECST_OFFSET(Adapter, Address) & 15);
=1 609 3
+            Piece = 2 - (LANCE_DECST_OFFSET(Adapter, Address) & 1);
=1 442 3
+        if (Piece > Length) {
+
+            Piece = Length;
=1 442 3
+        if (Buffer) {
+
+            NdisZeroMappedMemory(LANCE_HARDWARE_BUFFER(Adapter, Address), Piece);
=1 609 3
+            NdisZeroMappedMemory(LANCE_HARDWARE_WORD(Adapter, Address), Piece);
=1 442 3
+        Address += Piece;
+        Length -= Piece;
+
=1 3341 3 -4
+
+VOID
+LanceMoveToHardwareBuffer(
=1 170 1
+    IN PVOID Destination,
+    IN PVOID Source,
+    IN UINT Length
=1 262 6
+    This routine moves data to a buffer of the adapter.  The data of a
+    buffer of the LANCE of the system slot of a DECstation is moved a
+    piece at a time, each piece the part of 16 bytes of the buffer that is
+    in one place of its window (see lancehrd.h).
=1 272 3
+    Adapter - The adapter of the buffer.
+
+    Destination - The address in the buffer, as the driver keeps it.
+
+    Source - The data.
+
+    Length - The number of bytes to move.
=1 1773 8
+    PUCHAR To = (PUCHAR)Destination;
+    PUCHAR From = (PUCHAR)Source;
+    UINT Piece;
+
+    if (Adapter->LanceCard != LANCE_DECST) {
+
+        NdisMoveToMappedMemory(To, From, Length);
=1 1854 5
+    while (Length != 0) {
+
+        Piece = 16 - (LANCE_DECST_OFFSET(Adapter, To) & 15);
+
+        if (Piece > Length) {
+
+            Piece = Length;
=1 442 3
+        NdisMoveToMappedMemory(LANCE_HARDWARE_BUFFER(Adapter, To), From, Piece);
+
+        To += Piece;
+        From += Piece;
+        Length -= Piece;
+
=1 3341 3 -4
+
+VOID
+LanceMoveFromHardwareBuffer(
=1 170 1
+    IN PVOID Destination,
+    IN PVOID Source,
+    IN UINT Length
=1 262 6
+    This routine moves data from a buffer of the adapter, as
+    LanceMoveToHardwareBuffer moves it there.
=1 272 3
+    Adapter - The adapter of the buffer.
+
+    Destination - Where the data goes.
+
+    Source - The address in the buffer, as the driver keeps it.
+
+    Length - The number of bytes to move.
=1 1773 8
+    PUCHAR To = (PUCHAR)Destination;
+    PUCHAR From = (PUCHAR)Source;
+    UINT Piece;
+
+    if (Adapter->LanceCard != LANCE_DECST) {
+
+        NdisMoveFromMappedMemory(To, From, Length);
=1 1854 5
+    while (Length != 0) {
+
+        Piece = 16 - (LANCE_DECST_OFFSET(Adapter, From) & 15);
+
+        if (Piece > Length) {
+
+            Piece = Length;
=1 442 3
+        NdisMoveFromMappedMemory(To, LANCE_HARDWARE_BUFFER(Adapter, From), Piece);
+
+        To += Piece;
+        From += Piece;
+        Length -= Piece;
+
+    }
