+//
+// MiProtoAddressForKernelPte returns the bit field to OR into the PTE to
+// reference a prototype PTE for system space: an invalid R3000 PTE has no
+// global bit, so it is the same as for user space.
+//
=3 1339 4
=1 762 76
+#define GET_PAGING_FILE_NUMBER(PTE) ((((PTE).u.Long) & 0xC) |           \
+                                     ((((PTE).u.Long) >> 10) & 3))
=1 840 3
+//
+// Check to see if a given PTE is NOT a demand zero PTE: the prototype,
+// transition and valid bits and the paging file offset are zero in a
+// demand zero PTE.
+//
+
+#define IS_PTE_NOT_DEMAND_ZERO(PTE) ((PTE).u.Long & (ULONG)0xFFFFF203)
