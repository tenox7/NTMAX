+BOOLEAN
+CfbInterruptService(
=1 691 7
+    This routine is the interrupt service routine for the vertical retrace
+    interrupt of the color frame buffer.
=1 1705 14
+    LONG x;
+    LONG y;
+
+    //
+    // Clear the vertical retrace interrupt and disable it.
+    //
+
+    VideoPortWriteRegisterUchar(hwDeviceExtension->InterruptAddress, 0);
=1 1727 5
+    // Bt459 display controller. The red, green, and blue values of an entry
+    // are written in turn.
=1 1733 4
+        BT459_SET_ADDRESS(hwDeviceExtension->FirstEntry);
=1 1736 4
+            BT459_WRITE_COLOR(hwDeviceExtension->ColorMap[index].Red);
+            BT459_WRITE_COLOR(hwDeviceExtension->ColorMap[index].Green);
+            BT459_WRITE_COLOR(hwDeviceExtension->ColorMap[index].Blue);
=1 1742 16
+            // Store the position in the cursor position registers, x and
+            // then y, the low byte and then the high byte of each. A
+            // position above the screen, which the origin does not make
+            // positive, is set to the top.
=1 1761 7
+            if (x < 0) {
+                x = 0;
+            }
+
+            if (y < 0) {
+                y = 0;
+            }
+
+            BT459_SET_ADDRESS(BT459_CURSOR_X_LOW);
+            BT459_WRITE_REGISTER(x);
+            BT459_WRITE_REGISTER(x >> 8);
+            BT459_WRITE_REGISTER(y);
+            BT459_WRITE_REGISTER(y >> 8);
+
+            BT459_SET_ADDRESS(BT459_CURSOR_COMMAND);
+            BT459_WRITE_REGISTER(BT459_CURSOR_ON);
=1 494 3
+            BT459_SET_ADDRESS(BT459_CURSOR_COMMAND);
+            BT459_WRITE_REGISTER(BT459_CURSOR_OFF);
=1 1804 6
+    return TRUE;
+
+} // end CfbInterruptService()
