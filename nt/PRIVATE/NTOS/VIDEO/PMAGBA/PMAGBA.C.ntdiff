=1 1 6
+    pmagba.c
=1 8 3
+    This module contains the code that implements the miniport driver of
+    the color frame buffer of the DECstation 5000 (PMAG-BA), a TURBOchannel
+    option.
+
+    The color frame buffer displays 1024 by 864 pixels of eight bits with a
+    fixed timing, from a video memory of 1024 by 1024 bytes at the start of
+    its TURBOchannel slot. Its Bt459 display controller holds the color map
+    and a hardware cursor of 64 by 64 pixels of two bits. The frame buffer
+    requests an interrupt at the start of each vertical retrace, which loads
+    the color map and the cursor position and enable into the Bt459.
=1 13 15
+#include "decbt459.h"
=4 118 3
+// Define the layout of the TURBOchannel slot of the color frame buffer:
+// the video memory, the Bt459 display controller, and the interrupt
+// register, a write to which clears the vertical retrace interrupt.
+//
+
+#define CFB_FRAME_OFFSET     0x000000
+#define CFB_FRAME_LENGTH     0x100000
+#define CFB_CONTROL_OFFSET   0x200000
+#define CFB_INTERRUPT_OFFSET 0x300000
+
+//
+// Define the geometry and the timing of the color frame buffer, and the
+// size of the screen of its 19 inch monitor.
+//
+
+#define CFB_HORIZONTAL_RESOLUTION 1024
+#define CFB_VERTICAL_RESOLUTION   864
+#define CFB_SCREEN_STRIDE         1024
+#define CFB_VIDEO_MEMORY_HEIGHT   1024
+#define CFB_FREQUENCY             72
+#define CFB_X_MILLIMETER          350
+#define CFB_Y_MILLIMETER          295
+
+//
+// Define the offset of the cursor position of the Bt459 from the position
+// of the cursor on the screen: the Bt459 positions the cursor relative to
+// the sync of the fixed timing, not to the first pixel displayed.
+//
+
+#define CFB_CURSOR_X_ORIGIN 220
+#define CFB_CURSOR_Y_ORIGIN 35
+
+//
+// Defines used to determine which frame buffer is present. This is stored
+// in the DeviceTypeIdentifier in the device extension.
+//
+
+#define PMAGBA 1
+
+//
+// Define the identifier of the frame buffer, the module name of its option
+// ROM, which the firmware puts in the configuration of the TURBOchannel.
+// The length includes the terminating null.
+//
+
+#define PMAGBA_NAME        L"PMAG-BA"
+#define PMAGBA_NAME_LENGTH 16
+
+//
+// Define the Bt459 internal register addresses: the cursor color
+// registers, the identification register, the command registers, the
+// cursor command register and the cursor position that follows it, and
+// the cursor ram.
+//
+
+#define BT459_CURSOR_COLOR_1 0x181
+#define BT459_ID             0x200
+#define BT459_COMMAND_0      0x201
+#define BT459_CURSOR_COMMAND 0x300
+#define BT459_CURSOR_X_LOW   0x301
+#define BT459_CURSOR_RAM     0x400
+
+//
+// Define the value of the identification register of the Bt459, and the
+// cursor command register values: the cursor off, and the cursor
+// displaying both of its planes.
+//
+
+#define BT459_ID_VALUE   0x4a
+#define BT459_CURSOR_OFF 0x00
+#define BT459_CURSOR_ON  0xc0
+
+//
+// Define the hardware cursor and the color map.
=4 30 9
+    ((CURSOR_WIDTH * CURSOR_HEIGHT * CURSOR_BITS_PER_PIXEL) / 8)
+#define NUMBER_OF_CURSOR_COLORS 3       // cursor colors 1 to 3
+
+//
+// Define macros to access the display controller.
+//
+
+#define VIDEO_CONTROL (hwDeviceExtension->VideoAddress)
+
+#define BT459_SET_ADDRESS(Address)                                      \
+    VideoPortWriteRegisterUchar(&VIDEO_CONTROL->AddressLow.Byte,        \
+                                (UCHAR)(Address));                      \
+    VideoPortWriteRegisterUchar(&VIDEO_CONTROL->AddressHigh.Byte,       \
+                                (UCHAR)((Address) >> 8))
+
+#define BT459_WRITE_REGISTER(Value)                                     \
+    VideoPortWriteRegisterUchar(&VIDEO_CONTROL->RegisterData.Byte,      \
+                                (UCHAR)(Value))
+
+#define BT459_WRITE_COLOR(Value)                                        \
+    VideoPortWriteRegisterUchar(&VIDEO_CONTROL->ColorMapData.Byte,      \
+                                (UCHAR)(Value))
