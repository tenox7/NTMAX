=1 1864 7
+    This routine requests the vertical retrace interrupt that loads the
+    updates of the device extension into the Bt459. A vertical retrace
+    that occurred while the interrupt was disabled is cleared first, so the
+    update waits for the start of the next one.
=1 1252 5
=2 1155 10
+    VideoPortWriteRegisterUchar(HwDeviceExtension->InterruptAddress, 0);
+
+    VideoPortEnableInterrupt(HwDeviceExtension);
=1 1929 3
+} // end CfbRequestUpdate()
