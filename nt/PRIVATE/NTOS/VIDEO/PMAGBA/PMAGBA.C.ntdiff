+VOID
+CfbControllerSetup(
=1 1864 7
+    This routine initializes the Bt459 display controller chip. The timing
+    of the color frame buffer is fixed: the command registers select the
+    pixel format, and the cursor is turned off with the cursor colors set.
=1 1944 13
+    ULONG index;
+
+    //
+    // Initialize the Bt459 command registers: four to one multiplexing of
+    // the pixels, sync on green with the blanking pedestal, all eight planes
+    // read, and no blinking and no overlay.
+    //
+
+    BT459_SET_ADDRESS(BT459_COMMAND_0);
+    BT459_WRITE_REGISTER(0x40);         // command register 0
+    BT459_WRITE_REGISTER(0x00);         // command register 1
+    BT459_WRITE_REGISTER(0xc0);         // command register 2
+    BT459_WRITE_REGISTER(0xff);         // pixel read mask
+    BT459_WRITE_REGISTER(0x00);         // reserved
+    BT459_WRITE_REGISTER(0x00);         // pixel blink mask
+    BT459_WRITE_REGISTER(0x00);         // reserved
+    BT459_WRITE_REGISTER(0x00);         // overlay read mask
+    BT459_WRITE_REGISTER(0x00);         // overlay blink mask
+    BT459_WRITE_REGISTER(0x00);         // interleave
+    BT459_WRITE_REGISTER(0x00);         // test
+
+    //
+    // Turn the hardware cursor off.
+    //
+
+    BT459_SET_ADDRESS(BT459_CURSOR_COMMAND);
+    BT459_WRITE_REGISTER(BT459_CURSOR_OFF);
+
+    //
+    // Set the cursor colors. The red, green, and blue values of a color are
+    // written in turn.
+    //
+
+    BT459_SET_ADDRESS(BT459_CURSOR_COLOR_1);
+
+    for (index = 0; index < NUMBER_OF_CURSOR_COLORS; index++) {
+        BT459_WRITE_REGISTER(hwDeviceExtension->CursorColorMap[index].Red);
+        BT459_WRITE_REGISTER(hwDeviceExtension->CursorColorMap[index].Green);
+        BT459_WRITE_REGISTER(hwDeviceExtension->CursorColorMap[index].Blue);
=1 369 3
+    // Set the X and Y origin values for the cursor.
+    //
+
+    hwDeviceExtension->CursorXOrigin = CFB_CURSOR_X_ORIGIN;
+    hwDeviceExtension->CursorYOrigin = CFB_CURSOR_Y_ORIGIN;
=1 1929 3
+} // end CfbControllerSetup()
