+BOOLEAN
+CfbSetPointer(
=1 1246 8
+    It sets the shape of the pointer in the cursor ram of the Bt459, and
+    its position and enable in the device extension.
=1 1484 18
+    ULONG  index3;
=1 1505 4
+    UCHAR  PixelValue;
=1 1510 8
=1 1520 2
+    hwDeviceExtension->CursorColumn = (SHORT)pointerAttributes->Column;
+    hwDeviceExtension->CursorRow    = (SHORT)pointerAttributes->Row;
=1 1535 6
+    // Each hardware pixel has two bits, the pixel of plane one and the
+    // pixel of plane zero. The value 0 displays the pixel of the screen,
+    // the values 1 to 3 the cursor colors 1 to 3. Each byte of the
+    // cursor ram holds 4 pixels, the leftmost one in its high order bits;
+    // a scan line of the cursor is 16 bytes.
=1 1567 4
+    //  -----------------------      -----------------------
+    //  A7 A6 A5 A4 A3 A2 A1 A0      X7 X6 X5 X4 X3 X2 X1 X0
+    //
+    // into two bytes of hw Cursor ram, stored as
=1 1569 2
+    //  -----------------------      -----------------------
+    //  X7 A7 X6 A6 X5 A5 X4 A4      X3 A3 X2 A2 X1 A1 X0 A0
+    //
+    // with the And mask inverted: the pixels of an And mask of zero and an
+    // Xor mask of zero show cursor color 1, black, those of an And mask of
+    // zero and an Xor mask of one cursor color 3, white.
=1 1581 5
+    for (index1 = 0; index1 < (CURSOR_WIDTH / 8) * CURSOR_HEIGHT; index1++) {
=1 1587 3
+
+        for (index2 = 0; index2 < 2; index2++) {
+
+            PixelValue = 0;
+
+            for (index3 = 0; index3 < 4; index3++) {
=1 1593 3
+                PixelValue |= (UCHAR)((XorSrc & 0x80) >> 6);
+
+                PixelValue |= (UCHAR)((AndSrc & 0x80) >> 7);
+
+                AndSrc <<= 1;
+                XorSrc <<= 1;
=1 1164 3
+            hwDeviceExtension->CursorPixels[(index1 * 2) + index2] = PixelValue;
+        }
+
=1 1607 6
+    // Load the cursor ram immediately, with the cursor turned off, rather
+    // than in the interrupt service routine: the cursor ram is a thousand
+    // registers of the Bt459, more than a vertical retrace can load.
+    //
+
+    BT459_SET_ADDRESS(BT459_CURSOR_COMMAND);
+    BT459_WRITE_REGISTER(BT459_CURSOR_OFF);
+
+    BT459_SET_ADDRESS(BT459_CURSOR_RAM);
=1 1585 3
+        BT459_WRITE_REGISTER(hwDeviceExtension->CursorPixels[index1]);
=1 368 4
=1 1683 5
+    CfbRequestUpdate(hwDeviceExtension);
=1 716 3
+} // end CfbSetPointer()
