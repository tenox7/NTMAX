+VOID
+CfbAttributesSetup(
=1 1864 7
+    This routine initializes the device extension copy of the color map
+    and the hardware cursor.
=1 1872 12
+    ULONG index;
+
+    VideoDebugPrint((2,"CfbAttributesSetup\n"));
=1 1889 15
+        HwDeviceExtension->CursorPixels[index] = 0x00;
=1 1905 8
+    HwDeviceExtension->UpdateColorMap       = FALSE;
=1 1914 3
+    // set the cursor color map: color 1 is black, colors 2 and 3 are white.
+    //
+
+    HwDeviceExtension->CursorColorMap[0].Red   = 0x00;
+    HwDeviceExtension->CursorColorMap[0].Green = 0x00;
+    HwDeviceExtension->CursorColorMap[0].Blue  = 0x00;
+
+    for (index = 1; index < NUMBER_OF_CURSOR_COLORS; index++) {
+        HwDeviceExtension->CursorColorMap[index].Red   = 0xff;
+        HwDeviceExtension->CursorColorMap[index].Green = 0xff;
+        HwDeviceExtension->CursorColorMap[index].Blue  = 0xff;
+    }
=1 1929 3
+} // end CfbAttributesSetup()
