#ntdiff PRIVATE/NTOS/NTHALS/HALACR/MIPS/JXPORT.C
#crlf
=1 1 6
+    d3port.c
=1 8 4
+    the kernel debugger on a DECstation 5000 (MIPS R3000) and the kernel
+    debugger on another machine.
+
+    The kernel debugger uses serial line DEBUG_LINE (decdef.h), the
+    communications port. On the KN02 the line is a line of the DZ
+    multiplexer, whose other lines are the keyboard, the mouse, and the
+    console, so the multiplexer is not cleared and only the debugger line is
+    set up. On the KN02-BA and the KN03 the line is channel B of SCC 0
+    (decscc.h), whose channel A is the mouse, so the SCC is not reset and
+    only the channel of the debugger line is set up, without interrupts.
+    The DTR and RTS outputs of the line are outputs of channel A, which the
+    debugger sets before the port driver of the serial lines sets up the
+    mouse. The registers are addressed through KSEG1.
=1 14 14
+
+#if defined(KN02_AA)
+
+#include "decdz.h"
+
+#else
+
+#include "decscc.h"
=1 292 3
=1 45 11
+
+#if defined(KN02_AA)
+
+//
+// Define the line parameters of the debugger line.
+//
+
+USHORT HalpLineParameters;
+
+#else
+
+//
+// Define the SCC channel of the debugger line and the time constant of its
+// baud rate.
+//
+
+#define DEBUG_SCC_PHYSICAL_BASE \
+    ((SCC_LINE_SCC(DEBUG_LINE) == 0) ? SCC_PHYSICAL_BASE : SCC1_PHYSICAL_BASE)
+
+#define DEBUG_CHANNEL_PHYSICAL_BASE \
+    (DEBUG_SCC_PHYSICAL_BASE + SCC_LINE_OFFSET(DEBUG_LINE))
+
+#define DEBUG_CHANNEL \
+    ((PSCC_CHANNEL_REGISTERS)(KSEG1_BASE | DEBUG_CHANNEL_PHYSICAL_BASE))
+
+//
+// Define channel A of the SCC of the debugger line, which has the DTR and
+// RTS outputs of the line.
+//
+
+#define DEBUG_CONTROL_CHANNEL \
+    ((PSCC_CHANNEL_REGISTERS)(KSEG1_BASE | \
+                              (DEBUG_SCC_PHYSICAL_BASE + SCC_CHANNEL_A_OFFSET)))
+
+USHORT HalpTimeConstant;
+
+//
+// Define the routines that read and write a register of a channel.
+//
+
+UCHAR
+HalpReadSccRegister (
+    IN PSCC_CHANNEL_REGISTERS Channel,
+    IN ULONG Register
+    );
+
+VOID
+HalpWriteSccRegister (
+    IN PSCC_CHANNEL_REGISTERS Channel,
+    IN ULONG Register,
+    IN UCHAR Value
+    );
=1 292 3
+#if defined(KN02_AA)
+
=1 86 13
+    N.B. The receive silo of the multiplexer holds the characters of all
+         its lines. A character of another line that is read from the silo
+         here is discarded.
=1 98 22
+    USHORT DataShort;
=1 122 12
+        // Wait until a character of the debugger line is available in the
+        // receive silo.
=1 135 3
+        DataShort = READ_REGISTER_USHORT(&DZ_READ->ReceiveBuffer.Short);
+        if ((((PDZ_RECEIVE_BUFFER)(&DataShort))->DataValid == 0) ||
+            (((PDZ_RECEIVE_BUFFER)(&DataShort))->ReceiveLine != DEBUG_LINE)) {
=1 140 4
+        // Store input byte in callers buffer.
+        //
+
+        *Input = (UCHAR)((PDZ_RECEIVE_BUFFER)(&DataShort))->ReceiveData;
=1 160 5
+        if (((PDZ_RECEIVE_BUFFER)(&DataShort))->ParityError ||
+            ((PDZ_RECEIVE_BUFFER)(&DataShort))->FramingError ||
+            ((PDZ_RECEIVE_BUFFER)(&DataShort))->OverrunError) {
=1 169 8
+
+#else
+
=1 86 34
+    UCHAR Status;
=1 122 12
+        // Wait until a character is available in the receive buffer of the
+        // channel.
=1 135 3
+        if ((HalpReadSccRegister(DEBUG_CHANNEL, SCC_RR0) &
+             SCC_RR0_RECEIVE_AVAILABLE) == 0) {
=1 140 4
+        // Read the receive condition of the character, then store the input
+        // byte in callers buffer.
+        //
+
+        Status = HalpReadSccRegister(DEBUG_CHANNEL, SCC_RR1);
+        *Input = (UCHAR)(READ_REGISTER_ULONG(&DEBUG_CHANNEL->Data) >> SCC_BYTE_SHIFT);
+        KeStallExecutionProcessor(2);
+
+        //
+        // Return function value as the not of the error indicators. The
+        // error indicators of the channel are latched until they are reset.
+        //
+
+        if ((Status & (SCC_RR1_PARITY_ERROR | SCC_RR1_OVERRUN_ERROR |
+                       SCC_RR1_FRAMING_ERROR)) != 0) {
+            HalpWriteSccRegister(DEBUG_CHANNEL, SCC_WR0, SCC_WR0_ERROR_RESET);
=1 169 8
=1 292 3
=1 178 33
+    ULONG BaudRate;
+
+#if defined(KN02_AA)
+
+    USHORT DataShort;
+    USHORT SpeedCode;
+
+    //
+    // Compute the speed code of the line from the baud rate. The baud rate
+    // defaults to 19200, as does a baud rate the multiplexer does not have.
+    //
=1 235 3
+
=1 238 4
+    switch (BaudRate) {
+    case 4800:
+        SpeedCode = BAUD_4800;
+        break;
+
+    case 7200:
+        SpeedCode = BAUD_7200;
+        break;
+
+    case 9600:
+        SpeedCode = BAUD_9600;
+        break;
+
+    default:
+        SpeedCode = BAUD_19200;
+        break;
=1 240 3
+    // The line parameters of the debugger line are eight bit characters
+    // with one stop bit and no parity checking, and the receiver of the
+    // line is enabled.
+    //
+
+    DataShort = 0;
+    ((PDZ_LINE_PARAMETERS)(&DataShort))->LineNumber = DEBUG_LINE;
+    ((PDZ_LINE_PARAMETERS)(&DataShort))->CharacterLength = EIGHT_BIT_CHARACTERS;
+    ((PDZ_LINE_PARAMETERS)(&DataShort))->StopCode = ONE_STOP_BIT;
+    ((PDZ_LINE_PARAMETERS)(&DataShort))->SpeedCode = SpeedCode;
+    ((PDZ_LINE_PARAMETERS)(&DataShort))->ReceiveEnable = 1;
+    HalpLineParameters = DataShort;
=1 264 9
+    KdComPortInUse = (PUCHAR)DZ_PHYSICAL_BASE;
+
+    //
+    // Set the line parameters of the debugger line.
+    //
+
+    WRITE_REGISTER_USHORT(&DZ_WRITE->LineParameters.Short, HalpLineParameters);
+
+    //
+    // Set data terminal ready and request to send of the debugger line.
+    //
+
+    DataShort = READ_REGISTER_USHORT(&DZ_READ->TransmitControlRead.Short);
+    ((PDZ_TRANSMIT_CONTROL)(&DataShort))->DEBUG_LINE_NAME(DataTerminalReady) = 1;
+    ((PDZ_TRANSMIT_CONTROL)(&DataShort))->DEBUG_LINE_NAME(RequestToSend) = 1;
+    WRITE_REGISTER_USHORT(&DZ_WRITE->TransmitControlWrite.Short, DataShort);
+
+    //
+    // Enable the scan of the lines of the multiplexer.
+    //
+
+    DataShort = READ_REGISTER_USHORT(&DZ_READ->ControlStatus.Short);
+    ((PDZ_CONTROL_STATUS)(&DataShort))->MasterScanEnable = 1;
+    WRITE_REGISTER_USHORT(&DZ_WRITE->ControlStatus.Short, DataShort);
+    return TRUE;
+
+#else
+
+    //
+    // Compute the time constant of the baud rate generator of the channel
+    // from the baud rate. The baud rate defaults to 19200, as does a baud
+    // rate the generator cannot make.
+    //
+
=1 237 1 -4
+    if ((BaudRate < 300) || (BaudRate > 115200)) {
=1 239 3
+    HalpTimeConstant = (USHORT)SCC_TIME_CONSTANT(BaudRate);
=1 264 9
+    KdComPortInUse = (PUCHAR)DEBUG_CHANNEL_PHYSICAL_BASE;
+
+    //
+    // Disable the interrupts of the channel, and set eight bit characters
+    // with one stop bit and no parity, with the clock of the channel the
+    // baud rate generator divided by 16.
+    //
+
+    HalpWriteSccRegister(DEBUG_CHANNEL, SCC_WR1, 0);
+    HalpWriteSccRegister(DEBUG_CHANNEL, SCC_WR4,
+                         SCC_WR4_CLOCK_X16 | SCC_WR4_ONE_STOP_BIT);
+
+    HalpWriteSccRegister(DEBUG_CHANNEL, SCC_WR3, SCC_WR3_RECEIVE_8_BITS);
+    HalpWriteSccRegister(DEBUG_CHANNEL, SCC_WR5, SCC_WR5_TRANSMIT_8_BITS);
+
+    //
+    // Set the time constant of the baud rate generator, whose clock is the
+    // clock of the SCC, and start it.
+    //
+
+    HalpWriteSccRegister(DEBUG_CHANNEL, SCC_WR11, SCC_WR11_CLOCKS_BRG);
+    HalpWriteSccRegister(DEBUG_CHANNEL, SCC_WR14, SCC_WR14_BRG_PCLK);
+    HalpWriteSccRegister(DEBUG_CHANNEL, SCC_WR12, (UCHAR)HalpTimeConstant);
+    HalpWriteSccRegister(DEBUG_CHANNEL, SCC_WR13,
+                         (UCHAR)(HalpTimeConstant >> 8));
+
+    HalpWriteSccRegister(DEBUG_CHANNEL, SCC_WR14,
+                         SCC_WR14_BRG_PCLK | SCC_WR14_BRG_ENABLE);
+
+    //
+    // Enable the receiver and the transmitter of the channel.
+    //
+
+    HalpWriteSccRegister(DEBUG_CHANNEL, SCC_WR3,
+                         SCC_WR3_RECEIVE_8_BITS | SCC_WR3_RECEIVE_ENABLE);
+
+    HalpWriteSccRegister(DEBUG_CHANNEL, SCC_WR5,
+                         SCC_WR5_TRANSMIT_8_BITS | SCC_WR5_TRANSMIT_ENABLE);
+
+    //
+    // Set data terminal ready and request to send of the line, the outputs
+    // of channel A. The transmitter of channel A stays disabled.
+    //
+
+    HalpWriteSccRegister(DEBUG_CONTROL_CHANNEL, SCC_WR5,
+                         SCC_WR5_DTR | SCC_WR5_TRANSMIT_8_BITS | SCC_WR5_RTS);
+
+    return TRUE;
=1 292 3
+}
+
=1 374 36
+
=1 411 37
+    // Save port status, get byte from the debugger port is one is
+    // avaliable, restore port status, and return the operation status.
=1 451 7
+
=1 459 27
+#if defined(KN02_AA)
+
+    USHORT DataShort;
+    USHORT Enable;
+    USHORT TransmitControl;
+
+    //
+    // Enable the transmitter of the debugger line and wait for transmit
+    // ready. The multiplexer scans the enabled lines and reports a line
+    // that can take a character in the control status register. Another
+    // line that it reports is disabled until the character is transmitted.
+    //
+
+    TransmitControl = READ_REGISTER_USHORT(&DZ_READ->TransmitControlRead.Short);
+    Enable = TransmitControl | (1 << DEBUG_LINE);
+    WRITE_REGISTER_USHORT(&DZ_WRITE->TransmitControlWrite.Short, Enable);
+    for (;;) {
+        DataShort = READ_REGISTER_USHORT(&DZ_READ->ControlStatus.Short);
+        if (((PDZ_CONTROL_STATUS)(&DataShort))->TransmitReady != 0) {
+            if (((PDZ_CONTROL_STATUS)(&DataShort))->TransmitLine == DEBUG_LINE) {
+                break;
+            }
+
+            Enable &= ~(1 << ((PDZ_CONTROL_STATUS)(&DataShort))->TransmitLine);
+            WRITE_REGISTER_USHORT(&DZ_WRITE->TransmitControlWrite.Short, Enable);
=1 503 4
+    // Transmit data and restore the transmitter enables of the lines.
+    //
+
+    WRITE_REGISTER_USHORT(&DZ_WRITE->TransmitBuffer.Short, (USHORT)Output);
+    WRITE_REGISTER_USHORT(&DZ_WRITE->TransmitControlWrite.Short, TransmitControl);
+    return;
+
+#else
+
+    //
+    // Wait for the transmit buffer of the channel to be empty, then transmit
+    // data.
+    //
+
+    while ((HalpReadSccRegister(DEBUG_CHANNEL, SCC_RR0) &
+            SCC_RR0_TRANSMIT_EMPTY) == 0) {
+    }
+
+    WRITE_REGISTER_ULONG(&DEBUG_CHANNEL->Data, (ULONG)Output << SCC_BYTE_SHIFT);
+    KeStallExecutionProcessor(2);
+    return;
=1 292 3
+}
+
=1 528 12
+    N.B. This routine performs no function on the DECstation system.
=1 541 13
+    return;
+}
+
=1 567 12
+    N.B. This routine performs no function on the DECstation system: the
+         multiplexer or the SCC is addressed through KSEG1, and the
+         parameters of the debugger line are never changed by another
+         component.
=1 541 13
+    return;
+}
+
+#if !defined(KN02_AA)
+
+UCHAR
+HalpReadSccRegister (
+    IN PSCC_CHANNEL_REGISTERS Channel,
+    IN ULONG Register
=1 90 6
+    This routine reads a read register of a channel of the SCC of the
+    debugger line. A register other than RR0 is selected with a write to the
+    control register of the channel first. The SCC needs time to recover
+    after each access of a register.
=1 98 3
+    Channel - Supplies a pointer to the registers of the channel.
+
+    Register - Supplies the number of the read register.
=1 106 3
+    The value of the register.
=1 115 5
+    UCHAR Value;
+
+    if (Register != SCC_RR0) {
+        WRITE_REGISTER_ULONG(&Channel->Control, Register << SCC_BYTE_SHIFT);
+        KeStallExecutionProcessor(2);
+    }
+
+    Value = (UCHAR)(READ_REGISTER_ULONG(&Channel->Control) >> SCC_BYTE_SHIFT);
+    KeStallExecutionProcessor(2);
+    return Value;
+}
+
+VOID
+HalpWriteSccRegister (
+    IN PSCC_CHANNEL_REGISTERS Channel,
+    IN ULONG Register,
+    IN UCHAR Value
=1 90 6
+    This routine writes a write register of a channel of the SCC of the
+    debugger line. A register other than WR0 is selected with a write to the
+    control register of the channel first. The SCC needs time to recover
+    after each access of a register.
=1 98 3
+    Channel - Supplies a pointer to the registers of the channel.
+
+    Register - Supplies the number of the write register.
+
+    Value - Supplies the value that is written.
=1 477 9
+    if (Register != SCC_WR0) {
+        WRITE_REGISTER_ULONG(&Channel->Control, Register << SCC_BYTE_SHIFT);
+        KeStallExecutionProcessor(2);
+    }
+
+    WRITE_REGISTER_ULONG(&Channel->Control, (ULONG)Value << SCC_BYTE_SHIFT);
+    KeStallExecutionProcessor(2);
+    return;
+}
+
+#endif
