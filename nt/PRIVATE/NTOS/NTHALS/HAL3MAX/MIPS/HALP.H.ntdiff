+
+VOID
+HalpWriteSystemControl (
=1 67 3
+#else
+
+VOID
+HalpWriteInterruptMask (
=1 67 4
+HalpWriteSystemSupport (
+    IN ULONG Clear,
+    IN ULONG Set
=1 151 4
+#if defined(KN02_BA)
+
+VOID
+HalpTurboChannelDispatch (
=1 67 3
+#endif
=1 169 4
+// The builtin interrupt enables are the interrupt enable field of the
+// system control and status register on the KN02, the system interrupt
+// mask register of the IO Control ASIC on the KN02-BA and the KN03.
=1 172 3
+
+#if defined(KN02_AA)
+
+extern UCHAR HalpBuiltinInterruptEnable;
+
+#else
+
+extern ULONG HalpBuiltinInterruptEnable;
=1 29 3
=1 176 2
+extern LARGE_INTEGER HalpPerformanceCounter;
=1 182 1
+extern BOOLEAN HalpProfilingActive;
=1 183 1
+
+#if defined(KN02_AA)
+
+extern ULONG HalpSystemControl;
=1 29 3
=1 184 3
