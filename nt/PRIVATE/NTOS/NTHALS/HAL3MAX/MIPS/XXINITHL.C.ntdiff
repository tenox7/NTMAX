#ntdiff PRIVATE/NTOS/NTHALS/HALFXS/MIPS/XXINITHL.C PRIVATE/NTOS/NTHALS/HALACR/MIPS/XXINITHL.C PRIVATE/NTOS/NTHALS/HALSGI/MIPS/XXINITHL.C
