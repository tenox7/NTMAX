=1 407 3
+
+VOID
+HalpMemoryInterrupt (
=1 524 7
+    This function is called when a memory error interrupt occurs. The KN02
+    interrupts for an ECC error or a timeout of a memory or TURBOchannel
+    transaction that is not a read of the processor, which takes a bus
+    error instead.
+
+    The memory corrects a single bit error: the error is counted and
+    dismissed. Otherwise, the system is bug checked specifying the failed
+    memory address, the check syndrome, and the system control and status
+    register.
=1 532 5
=1 301 8
+    ULONG CheckSyndrome;
+    ULONG FailedAddress;
+    ULONG SystemControl;
+
+    //
+    // Read the memory error registers. If the error is an ECC error and
+    // each word with valid error data has a single bit error, then the
+    // memory corrected the error.
+    //
+
+    FailedAddress = READ_REGISTER_ULONG(ERROR_ADDRESS);
+    CheckSyndrome = READ_REGISTER_ULONG(CHECK_SYNDROME);
+    if (((FailedAddress & ERROR_ADDRESS_VALID) != 0) &&
+        ((FailedAddress & ERROR_ADDRESS_ECC) != 0) &&
+        ((CheckSyndrome & (CHECK_SYNDROME_VALID_HIGH | CHECK_SYNDROME_VALID_LOW)) != 0) &&
+        (((CheckSyndrome & CHECK_SYNDROME_VALID_HIGH) == 0) ||
+         ((CheckSyndrome & CHECK_SYNDROME_SINGLE_HIGH) != 0)) &&
+        (((CheckSyndrome & CHECK_SYNDROME_VALID_LOW) == 0) ||
+         ((CheckSyndrome & CHECK_SYNDROME_SINGLE_LOW) != 0))) {
+        HalpCorrectedMemoryErrors += 1;
+        WRITE_REGISTER_ULONG(ERROR_ADDRESS, 0);
+        return;
+    }
+
+    SystemControl = READ_REGISTER_ULONG((PULONG)&SYS_CONTROL->SysControlStatus.Read);
+    KeBugCheckEx(NMI_HARDWARE_FAILURE,
+                 (FailedAddress & ERROR_ADDRESS_WORD) << 2,
+                 FailedAddress,
+                 CheckSyndrome,
+                 SystemControl);
=1 545 3
+
=1 411 29
+
=1 441 12
+    N.B. The DECstation 5000/200 has one processor.
=1 452 19
+    return FALSE;
+}
