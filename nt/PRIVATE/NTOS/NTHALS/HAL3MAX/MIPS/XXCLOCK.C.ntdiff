#ntdiff PRIVATE/NTOS/NTHALS/HALTYNE/MIPS/XXCLOCK.C PRIVATE/NTOS/NTHALS/HALFXS/MIPS/XXCLOCK.C
#crlf
=2 1 29
+// Define global data used by the clock interrupt service routine.
=1 55 3
=1 111 16
+    N.B. The interval clock of the DECstation is the periodic interrupt of
+         the realtime clock, which has one rate.
=1 126 14
+    return HalpCurrentTimeIncrement;
+}
