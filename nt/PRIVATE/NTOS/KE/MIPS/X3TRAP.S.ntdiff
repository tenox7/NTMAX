+//
+// Pop the mode and interrupt enable of the user TB miss routine from the
+// PSR and continue execution at the exception PC of the user TB miss.
+//
+
+30:     mfc0    k0,psr                  // get current processor status
+        nop                             // 1 cycle hazzard
