+        srl     k1,k1,FLOAT_LEVEL + CAUSE_INTPEND - 1 // isolate floating interrupt
+        and     k1,k1,1                 //
+        beq     zero,k1,55f             // if eq, no floating interrupt
+        nop                             // fill
