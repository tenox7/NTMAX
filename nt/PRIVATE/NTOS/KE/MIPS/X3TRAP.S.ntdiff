+        and     k1,k1,0x3 << PSR_IEP    // previous position
+        or      k0,k0,k1                // set previous mode and enable
+        mtc0    k0,psr                  // set new processor status
+        lw      k1,KiPcr + PcSavedEpc(zero) // get user TB miss exception PC
+        nop                             // 1 cycle hazzard
+        j       k1                      // repeat the reference
+        rfe                             // restore mode and interrupt enable
