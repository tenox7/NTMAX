#ntdiff PRIVATE/NTOS/KE/MIPS/X4TRAP.S PRIVATE/NTOS/FW/MIPS/X4TRAP.S PRIVATE/NTOS/KE/MIPS/THREADBG.S PRIVATE/NTOS/KE/MIPS/XXAPCINT.S
=1 1 7
+//    x3trap.s
=1 9 6
+//    This is the R3000 version. The R3000 has a user TB miss vector for
+//    misses on the user part of the address space and a general exception
+//    vector for all other exceptions. The TB maps single pages, the process
+//    status register has a three level stack of mode and interrupt enable
+//    bits that is pushed by an exception and popped by rfe, and floating
+//    exceptions are signaled by the floating point coprocessor as an
+//    interrupt at FLOAT_LEVEL.
=1 14 20
+
=1 35 7
+#define PSR_ENABLE_MASK ((0xff << PSR_INTMASK) | (0x3 << PSR_IEC))
=1 45 5
+// Define the offset of the PTE load in the user TB miss vector routine.
+//
+
+#define TB_MISS_PTE_LOAD 0x8            // offset of PTE load instruction
=1 48 25
=1 117 24
+        SBTTL("User TB Miss Vector Routine")
=1 142 5
+//    to the user part of the address space from either kernel or user mode.
=1 148 2
+//    The function of this routine is to load a second level PTE from the
+//    current page table into the TB. The context register is loaded by
+//    hardware with the virtual address of the PTE. In addition, the entryhi
+//    register is loaded with the virtual tag, such that the PTE can be loaded
+//    directly into the TB.
+//
+//    If a fault occurs when attempting to load the specified PTE from the
=1 159 1
+//    vector at KSEG0_BASE + 0x80.
=1 161 11
+//    N.B. This routine saves the exception PC in k1 before the PTE is
+//       loaded so that it can be used by the general exception vector
+//       routine if an exception occurs while trying to load the PTE from
+//       memory. The PTE load must remain at offset TB_MISS_PTE_LOAD.
=1 176 5
+        START_REGION(KiTbMissStartAddress)
=1 187 3
+        mfc0    k0,context              // get virtual address of PTE
=2 107 1
+        lw      k0,0(k0)                // get PTE - may fault
+        nop                             // 1 cycle hazzard
+        mtc0    k0,entrylo              // set PTE value
+        nop                             // 1 cycle hazzard
=1 240 1
+        j       k1                      // return from exception
+        rfe                             // restore mode and interrupt enable
=1 261 6
+
=1 323 16
+//    This routine is copied to address KSEG0_BASE + 0x80 at system startup.
=1 340 7
+//    k1 - Supplies the exception PC of the user TB miss if the exception
+//       occurred in the user TB miss vector routine while attempting to load
+//       a PTE into the TB.
=1 350 14
+        nop                             // 1 cycle hazzard
+        and     k0,k0,R3000_MISS_MASK   // isolate exception code
+        xor     k0,k0,XCODE_READ_MISS   // check for read or write miss
=1 367 7
+        bne     zero,k0,40f             // if ne, not read or write miss
+        mfc0    k0,epc                  // get exception PC
+
+//
+// The exception is either a read or a write to an address that is not in
+// the user part of the address space and is not mapped by the TB, or a
+// reference to an invalid entry that is in the TB.
+//
+// N.B. A TB miss on an address in the user part of the address space is
+//      vectored to the user TB miss routine, which loads the PTE into the
+//      TB whether it is valid or not.
+//
+// Attempt to resolve the reference by loading the PTE from the page table
+// page that maps the bad virtual address. The page directory page is mapped
+// by a fixed TB entry and the page table page is addressed in KSEG0, and
+// therefore, the PTE is obtained without a TB miss.
+//
+// There are two cases to be considered:
+//
+//    1. The exception occurred in the user TB miss routine while attempting
+//       to load a PTE from the current page table.
+//
+//       For this case, the bad virtual address is the address of the PTE,
+//       the TB entry that maps the page table page is loaded from the page
+//       directory page, and execution is resumed at the exception PC of the
+//       user TB miss, which is in k1. If the page table page does not exist,
+//       then an invalid entry is loaded into the TB for the user page, which
+//       causes the user reference to fault on the invalid entry.
+//
+//       N.B. The return to the exception PC of the user TB miss pops two
+//            levels of the mode and interrupt enable stack in the PSR.
+//
+//    2. The exception occurred elsewhere.
+//
+//       For this case, the PTE that maps the bad virtual address is loaded
+//       into the TB if it is valid and execution is continued. Otherwise,
+//       the exception is a page fault and is passed to the appropriate
+//       exception routine.
+//
+// N.B. The TB is probed before a valid PTE is loaded into the TB. If the TB
+//      contains an invalid entry for the bad virtual address, then the entry
+//      is overwritten. A TB that contains two matching entries shuts down.
+//
+
+        nop                             // 1 cycle hazzard
+        bgez    k0,10f                  // if gez, exception PC in user space
+        sll     k0,k0,1                 // isolate offset of exception PC
+        xor     k0,k0,TB_MISS_PTE_LOAD << 1 // check if PTE load of user TB miss
+        beq     zero,k0,20f             // if eq, exception in user TB miss
=1 716 3
+// Case 2 - The exception did not occur in the user TB miss routine.
+//
+// Load the PDE that maps the page table page from the page directory page.
+//
+
+10:     mfc0    k0,badvaddr             // get bad virtual address
+        lui     k1,PDE_BASE >> 16       // get virtual address of PDR
+        srl     k0,k0,PDI_SHIFT         // isolate page directory index
+        sll     k0,k0,2                 // compute offset of PDE
+        or      k0,k0,k1                // compute virtual address of PDE
+        lw      k0,0(k0)                // get PDE value
+        nop                             // 1 cycle hazzard
+        sll     k1,k0,0x1f - ENTRYLO_V  // shift valid bit into sign position
+        bgez    k1,40f                  // if gez, PDE is not valid
+        srl     k0,k0,ENTRYLO_PFN       // isolate page frame number
+
+//
+// Load the PTE that maps the bad virtual address from the page table page.
+//
+
=1 211 1
+        sll     k0,k0,PAGE_SHIFT        // compute physical address of page
+        srl     k1,k1,PTI_SHIFT - 2     // compute offset of PTE
+        and     k1,k1,0xffc             //
+        or      k0,k0,k1                // compute physical address of PTE
+        lui     k1,KSEG0_BASE >> 16     // compute KSEG0 address of PTE
+        or      k0,k0,k1                //
+        lw      k0,0(k0)                // get PTE value
+        nop                             // 1 cycle hazzard
+        sll     k1,k0,0x1f - ENTRYLO_V  // shift valid bit into sign position
+        bgez    k1,40f                  // if gez, PTE is not valid
=1 495 3
+// An address in system space is mapped by a global TB entry.
+//
+
+        nop                             // 1 cycle hazzard
+        srl     k1,k1,23                // isolate high bits of virtual address
+        addu    k1,k1,-(SYSTEM_BASE >> 23) // check if system space address
+        bltz    k1,15f                  // if ltz, not system space address
+        nop                             // fill
+        or      k0,k0,1 << ENTRYLO_G    // set global bit
+15:     tlbp                            // probe TB for bad virtual address
+        nop                             // 1 cycle hazzard
=1 431 1
+        mtc0    k0,entrylo              // set PTE value
+        bltz    k1,17f                  // if ltz, entry is not in TB
+        nop                             // fill
+        tlbwi                           // overwrite invalid entry in TB
=2 107 1
+        nop                             // 1 cycle hazzard
+        j       k1                      // continue execution
+        rfe                             // restore mode and interrupt enable
+
+17:     tlbwr                           // write entry randomly into TB
=2 107 1
+        nop                             // 1 cycle hazzard
+        j       k1                      // continue execution
+        rfe                             // restore mode and interrupt enable
+
+//
+// Case 1 - The exception occurred in the user TB miss routine.
+//
+// The bad virtual address is the address of a PTE. Save the exception PC
+// of the user TB miss and load the PDE that maps the page table page from
+// the page directory page.
+//
+
+20:     sw      k1,KiPcr + PcSavedEpc(zero) // save user TB miss exception PC
+        mfc0    k0,badvaddr             // get virtual address of PTE
+        lui     k1,PDE_BASE >> 16       // get virtual address of PDR
+        srl     k0,k0,PTI_SHIFT - 2     // compute offset of PDE
+        and     k0,k0,0xffc             //
+        or      k0,k0,k1                // compute virtual address of PDE
+        lw      k0,0(k0)                // get PDE value
+        nop                             // 1 cycle hazzard
+        sll     k1,k0,0x1f - ENTRYLO_V  // shift valid bit into sign position
+        bgez    k1,25f                  // if gez, PDE is not valid
+        nop                             // fill
+        tlbp                            // probe TB for page table page
+        nop                             // 1 cycle hazzard
=1 431 1
+        mtc0    k0,entrylo              // set PDE value
+        bltz    k1,23f                  // if ltz, entry is not in TB
+        nop                             // fill
+        tlbwi                           // overwrite invalid entry in TB
+        b       30f                     // finish in common code
+        nop                             // fill
+
+23:     tlbwr                           // write entry randomly into TB
+        b       30f                     // finish in common code
=1 716 3
+// The page table page does not exist. Load an invalid entry for the user
+// page into the TB.
+//
+
+25:     mfc0    k0,badvaddr             // get virtual address of PTE
+        mfc0    k1,entryhi              // get current PID
