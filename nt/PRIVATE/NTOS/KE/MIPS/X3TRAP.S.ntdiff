+        and     k1,k1,PID_MASK << ENTRYHI_PID // isolate current PID
+        or      k0,k0,k1                // merge PID with virtual page number
+        mtc0    k0,entryhi              // set VPN and PID of user page
+        mtc0    zero,entrylo            // set invalid PTE value
+        nop                             // 1 cycle hazzard
=1 240 1
