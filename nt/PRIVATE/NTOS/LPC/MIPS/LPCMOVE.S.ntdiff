#ntdiff PRIVATE/NTOS/LPC/MIPS/LPCMOVE.S
#crlf
=1 1 79
+
+#if defined(R3000)
+
+        lw      t4,8(a1)                // get client id from source
+        lw      t5,12(a1)               //
=1 81 1
+        lw      t4,0(v0)                // get specified client id
+        lw      t5,4(v0)                //
+20:     sw      t4,8(a0)                // store client id
+        sw      t5,12(a0)               //
+        lw      t4,16(a1)               // move message id and view size
+        lw      t5,20(a1)               //
+        sw      t4,16(a0)               //
+        sw      t5,20(a0)               //
=1 87 3
+30:     lw      t4,0(a2)                // get next quadword of source data
+        lw      t5,4(a2)                //
=1 92 2
+        sw      t4,24 - 8(a0)           // store next quadword of destination
+        sw      t5,24 - 4(a0)           //
=1 95 1
+
+#endif
+
+#if defined(R4000)
+
=1 80 16
+
+#endif
+
=1 96 7
