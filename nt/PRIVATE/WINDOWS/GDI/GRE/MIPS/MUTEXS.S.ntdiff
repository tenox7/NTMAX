#ntdiff PRIVATE/WINDOWS/GDI/GRE/MIPS/MUTEXS.S PRIVATE/WINDOWS/GDI/GRE/ALPHA/MUTEXS.S PRIVATE/NTOS/EX/MIPS/FMUTEX.S
#crlf
+#if defined(R3000) || defined(R4000)
=1 2 24
+//    The R3000 port: the interlocked operations with the interlocked
+//    helpers of ntdll, which the system restarts if they are interrupted.
=1 25 18
+
+#if !defined(R4000)
+
+//
+// Define the stack frame of the R3000 fast mutex routines.
=1 33 3
+        .space  4 * 4                   // argument register save area
=2 39 1
=3 58 1
+FmFrameLength:                          // length of stack frame
+FmA0:   .space  4                       // saved address of fast mutex
=1 76 3
=1 44 61
+#if defined(R4000)
=1 104 36
+
+#else
=1 104 13
+        b       AcquireFastMutex        // finish in common code
=1 138 2
+
+        NESTED_ENTRY(AcquireFastMutex, FmFrameLength, zero)
+
+        subu    sp,sp,FmFrameLength     // allocate stack frame
=3 64 5
=1 120 3
=3 107 1
+        addu    a0,a0,mutex_Count       // compute address of lock value
+        jal     RtlpLeaveCritSecHelper  // interlocked decrement lock value
+        lw      a0,FmA0(sp)             // restore address of fast mutex
=3 131 1
+        addu    sp,sp,FmFrameLength     // deallocate stack frame
+        bltz    v0,20f                  // if ltz, lock is already owned
=1 128 6
+20:     lw      a0,mutex_heveEvent(a0)  // get event handle
=1 135 4
+        .end    AcquireFastMutex
=1 76 3
=1 141 26
+#if defined(R4000)
=1 166 27
+
+#else
=1 166 4
+        b       ReleaseFastMutex        // finish in common code
=1 191 2
+
+        NESTED_ENTRY(ReleaseFastMutex, FmFrameLength, zero)
+
+        subu    sp,sp,FmFrameLength     // allocate stack frame
=3 64 5
=1 174 3
=3 107 1
+        addu    a0,a0,mutex_Count       // compute address of lock value
+        jal     RtlpEnterCritSecHelper  // interlocked increment lock value
+        lw      a0,FmA0(sp)             // restore address of fast mutex
=3 131 1
+        addu    sp,sp,FmFrameLength     // deallocate stack frame
+        subu    v0,v0,1                 // compute previous lock value
+        bne     zero,v0,20f             // if ne, there is a waiter
=1 182 6
+20:     lw      a0,mutex_heveEvent(a0)  // get event handle
=1 189 3
+        .end    ReleaseFastMutex
=1 76 3
=1 194 47
+#if defined(R4000)
=1 240 15
+
+#else
+
+        sw      a0,HmA0(sp)             // save handle value
=1 337 1
+        la      a0,gfmHmgr + mutex_Count // set address of lock value
+        jal     RtlpLeaveCritSecHelper  // interlocked decrement lock value
=1 355 2
=1 241 4
=1 246 2
+        bltz    v0,60f                  // if ltz, lock is already owned
=1 114 3
=1 255 27
+#if !defined(R4000)
+
+        nop                             // load delay
+
+#endif
=1 282 34
+#if defined(R4000)
=1 315 6
+
+#else
+
+50:     sw      v0,HmV0(sp)             // save object address
+        la      a0,gfmHmgr + mutex_Count // set address of lock value
+        jal     RtlpEnterCritSecHelper  // interlocked increment lock value
+        subu    t1,v0,1                 // compute previous lock value
=1 368 2
=1 241 1
=1 320 1
=1 114 3
=1 321 101
+#if defined(R4000)
=1 421 12
+
+#else
+
+        sw      a0,HmA0(sp)             // save handle value
=1 337 1
+        la      a0,gfmHmgr + mutex_Count // set address of lock value
+        jal     RtlpLeaveCritSecHelper  // interlocked decrement lock value
=1 355 2
=1 241 1
=1 246 2
+        bltz    v0,50f                  // if ltz, lock is already owned
=1 114 3
=1 433 27
+#if !defined(R4000)
+
+        nop                             // load delay
+
+#endif
=1 460 7
+#if defined(R4000)
=1 466 6
+#else
+
+30:     sw      v0,HmV0(sp)             // save object address
+        addu    a0,v0,object_cShareLock // compute address of reference count
+        jal     RtlpEnterCritSecHelper  // interlocked increment reference count
=1 368 1
=1 422 2
+#endif
=1 311 5
+#if defined(R4000)
=1 475 6
+
+#else
+
+40:     sw      v0,HmV0(sp)             // save object address
+        la      a0,gfmHmgr + mutex_Count // set address of lock value
+        jal     RtlpEnterCritSecHelper  // interlocked increment lock value
+        subu    t1,v0,1                 // compute previous lock value
=1 368 2
=1 241 1
=1 480 1
=1 114 3
=1 481 97
+#if defined(R4000)
=1 577 14
+
+#else
+
+        sw      a0,HmA0(sp)             // save handle value
=1 337 1
+        la      a0,gfmHmgr + mutex_Count // set address of lock value
+        jal     RtlpLeaveCritSecHelper  // interlocked decrement lock value
=1 355 2
=1 578 3
=1 246 2
+        bltz    v0,50f                  // if ltz, lock is already owned
=1 114 3
=1 591 42
+#if defined(R4000)
=1 466 6
+#else
+
+30:     sw      v0,HmV0(sp)             // save object address
+        addu    a0,v0,object_cShareLock // compute address of reference count
+        jal     RtlpEnterCritSecHelper  // interlocked increment reference count
=1 368 1
=1 422 2
+#endif
=1 311 5
+#if defined(R4000)
=1 475 6
+
+#else
+
+40:     sw      v0,HmV0(sp)             // save object address
+        la      a0,gfmHmgr + mutex_Count // set address of lock value
+        jal     RtlpEnterCritSecHelper  // interlocked increment lock value
+        subu    t1,v0,1                 // compute previous lock value
=1 368 2
=1 241 1
=1 480 1
=1 114 3
=1 647 53
