#ntdiff PRIVATE/NTOS/FW/MIPS/FWLOAD.C
=1 1 985
+#if defined(DECSTATION)
+
+                //
+                // The program, or the system it starts, can drive the
+                // controller of the boot device: the non-volatile
+                // configuration is written when the firmware gets control
+                // back.  The system can also take page zero, where the
+                // console keeps its work area: the page is saved, to be
+                // put back before the console gets control again.  The
+                // console shows the program and where it starts.
+                //
+
+                FwPrint(FW_PROGRAM_START_MSG, TempPath, (ULONG)TransferRoutine);
+                FwNvramDefer();
+                FwRexSavePageZero();
+#endif
=1 985 7
+#if defined(DECSTATION)
+                FwNvramRelease();
+#endif
=1 992 52
