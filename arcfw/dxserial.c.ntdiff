=1 180 8
+    USHORT DataShort;
+    USHORT Enable;
+
+    //
+    // Enable the transmitter of the line.  The DZ scans the enabled lines
+    // and reports a line that can take a character in the control status
+    // register.  Disable any other line it reports.
+    //
+
+    Enable = READ_REGISTER_USHORT(&DZ_READ->TransmitControlRead.Short);
+    Enable |= (USHORT)(1 << SP);
+    WRITE_REGISTER_USHORT(&DZ_WRITE->TransmitControlWrite.Short, Enable);
+    for (;;) {
+        DataShort = READ_REGISTER_USHORT(&DZ_READ->ControlStatus.Short);
+        if (((PDZ_CONTROL_STATUS)(&DataShort))->TransmitReady != 0) {
+            if (((PDZ_CONTROL_STATUS)(&DataShort))->TransmitLine == SP) {
+                break;
+            }
+            Enable &= ~(1 << ((PDZ_CONTROL_STATUS)(&DataShort))->TransmitLine);
+            WRITE_REGISTER_USHORT(&DZ_WRITE->TransmitControlWrite.Short, Enable);
=3 2394 4
