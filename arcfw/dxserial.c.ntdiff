+VOID
+SerialPoll(
=3 2365 6
+    This routine empties the receiver silo of the DZ into the receive
+    buffers of the lines.  A character received while the buffer of its
+    line is full is lost.
=3 2375 11
+    USHORT DataShort;
+    PSERIAL_RECEIVE_BUFFER Receive;
+    ULONG Next;
+
+    for (;;) {
+        DataShort = READ_REGISTER_USHORT(&DZ_READ->ReceiveBuffer.Short);
+        if (((PDZ_RECEIVE_BUFFER)(&DataShort))->DataValid == 0) {
+            break;
+        }
+        Receive = &SerialReceiveBuffer[((PDZ_RECEIVE_BUFFER)(&DataShort))->ReceiveLine];
+        Next = (Receive->Tail + 1) % SERIAL_BUFFER_SIZE;
+        if (Next != Receive->Head) {
+            Receive->Data[Receive->Tail] =
+                (UCHAR)((PDZ_RECEIVE_BUFFER)(&DataShort))->ReceiveData;
+            Receive->Tail = Next;
+        }
=3 3183 3
