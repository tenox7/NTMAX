=1 10 3
+    This module implements the serial boot driver for the DECstation
+    5000/200.  The serial lines are lines of the DZ (DC7085) multiplexer:
+    serial(0) is line 2, the communications port, and serial(1) is line 3,
+    the console port.  The firmware uses serial(1) as its console.
+
+    The DZ has one receiver silo for its four lines.  Each character read
+    from the silo carries its line number, and the driver keeps the
+    characters received on each line in a buffer of the line until they
+    are read.
=1 14 15
=1 30 70
+#define SP_BASE(Fid) ULONG SP; \
+                     SP = BlFileTable[Fid].u.SerialContext.PortBase
+
+//
+// Define the DZ line of serial port 0, and the receive buffer of each line:
+// the characters from Head to Tail have been received and not read yet.
+//
+
+#define FIRST_SERIAL_LINE 2
+#define SERIAL_BUFFER_SIZE 64
+
+typedef struct _SERIAL_RECEIVE_BUFFER {
+    ULONG Head;
+    ULONG Tail;
+    UCHAR Data[SERIAL_BUFFER_SIZE];
+} SERIAL_RECEIVE_BUFFER, *PSERIAL_RECEIVE_BUFFER;
+
+SERIAL_RECEIVE_BUFFER SerialReceiveBuffer[4];
+
+//
+// Define the position of the cursor on the console terminal.  The console
+// output driver keeps it for the routines that edit a line where it is
+// shown (FwGetString), as the display driver of a video console does.
+//
+
+LONG FwRow;
+LONG FwColumn;
+
+//
+// Define the last row and column of the console terminal, and the state of
+// the escape or control sequence the console output is in.
+//
+
+#define CONSOLE_MAX_ROW 23
+#define CONSOLE_MAX_COLUMN 79
+#define CONSOLE_MAX_PARAMETER 2
+
+BOOLEAN SerialConsoleEscape;
+BOOLEAN SerialConsoleControl;
+ULONG SerialConsoleCount;
+ULONG SerialConsoleParameter[CONSOLE_MAX_PARAMETER];
