+UCHAR
+SerialReadScc (
+    IN PSCC_CHANNEL_REGISTERS Channel,
+    IN ULONG Register
=1 115 6
+    This routine reads a read register of an SCC channel: a write of the
+    number of the register to the control register selects it, except for
+    RR0, which is selected after each access.
=1 123 3
+    Channel - Supplies the address of the registers of the channel.
+
+    Register - Supplies the number of the read register.
=1 127 3
+    The value of the register.
=1 131 4
+    UCHAR Value;
+
+    if (Register != SCC_RR0) {
+        WRITE_REGISTER_ULONG(&Channel->Control, Register << SCC_BYTE_SHIFT);
+        FwStallExecution(SCC_RECOVERY_TIME);
+    }
+
+    Value = (UCHAR)(READ_REGISTER_ULONG(&Channel->Control) >> SCC_BYTE_SHIFT);
+    FwStallExecution(SCC_RECOVERY_TIME);
+    return Value;
+}
