#ntdiff PRIVATE/NTOS/FW/MIPS/JXREBOOT.C
=1 1 68
+#if defined(DECSTATION)
+
+        //
+        // The DECstation is reset by the console, which restarts the
+        // system the way its boot action does.  First, after a loaded
+        // program ran, the work area of the console in page zero is put
+        // back and the SCSI bus is reset for the boot driver of the
+        // console, and the non-volatile configuration is written, if the
+        // program, or the system it started, changed it.
+        //
+
+        FwRexReturnToConsole(REX_COMMAND_BOOT);
+#else
=1 69 2
+#endif
=1 71 27
+#if defined(DECSTATION)
+
+    //
+    // A halted DECstation waits at the console prompt.  First, after a
+    // loaded program ran, the work area of the console in page zero is
+    // put back and the SCSI bus is reset for the boot driver of the
+    // console, and the non-volatile configuration is written, if the
+    // program, or the system it started, changed it.
+    //
+
+    FwRexReturnToConsole(REX_COMMAND_HALT);
+#endif
=1 98 182
+#if defined(DECSTATION)
+
+    //
+    // The firmware has control again: write the non-volatile configuration,
+    // if a loaded program, or the system it started, changed it.
+    //
+
+    FwNvramRelease();
+#endif
=1 280 124
