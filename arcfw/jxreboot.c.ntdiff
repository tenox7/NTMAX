#ntdiff PRIVATE/NTOS/FW/MIPS/JXREBOOT.C
=1 1 68
+#if defined(DECSTATION)
+
+        //
+        // The DECstation is reset by the console, which restarts the
+        // system the way its boot action does.
+        //
+
+        FwRexReboot();
+#else
=1 69 2
+#endif
=1 71 27
+#if defined(DECSTATION)
+
+    //
+    // A halted DECstation waits at the console prompt.
+    //
+
+    FwRexHalt();
+#endif
=1 98 306
