#ntdiff PRIVATE/NTOS/FW/MIPS/SELFTEST.C PRIVATE/NTOS/FW/ALPHA/JENSEN/ALPHA/JNFS.C PRIVATE/NTOS/FW/ALPHA/JENSEN/ALPHA/SELFTEST.C
+/*++
=1 4 3
+    dxinit.c
=1 8 3
+    This module starts the ARC firmware on the DECstation 5000.  The REX
+    console has run the power-up self test and loaded the firmware, so
+    FwSelftest selects the description of the system module the firmware
+    runs on (dxsystem.c) and initializes what the self test of a Jazz ROM
+    initializes: the system parameter block, the boot status, the memory
+    size and the PCR.  Then it starts the boot manager.
+
+    The module also holds the interface to the REX console callback vector
+    (dectccbv.h), which the firmware uses to read and write the boot device,
+    to get the memory bitmap and the system identifier, and to halt and
+    reboot, and the routines that keep the work area the console has in
+    page zero while a loaded program runs and give the console its SCSI bus
+    back.
=1 17 3
+    Kernel mode only.
=1 22 4
=1 31 1
+#include "decfw.h"
+#include "ncr53c94.h"
+#define CALLBACK_VECTOR
+#include "dectccbv.h"
+
+//
+// Define the firmware version printed in the banner.
+//
+
+#define FW_VERSION 1
+
+//
+// Define the values saved from the console by FwStart, and the console
+// callback vector, which dectccbv.h names ccv.
+//
+
+ULONG FwRexArgc;
+PCHAR *FwRexArgv;
+ULONG FwRexMagic;
+PVOID FwRexVector;
+#define ccv ((PTcCBV)FwRexVector)
+
+//
+// Define the copy of page zero that FwRexSavePageZero takes when the
+// firmware invokes a program, and whether there is one.  The console keeps
+// its work area in the page (the state of its boot device among it), and
+// its boot read and write services use it.
+//
+
+ULONG FwRexPageZero[PAGE_SIZE / sizeof(ULONG)];
+BOOLEAN FwRexPageZeroSaved;
+
+//
+// Define the firmware stack, the memory size in megabytes and the state the
+// Jazz self test keeps.
+//
+
+ULONG FwStack[FW_STACK_SIZE / sizeof(ULONG)];
+
+//
+// Define the descriptions of the system modules the firmware runs on, the
+// description of the module it runs on, the address in KSEG1 of the error
+// register of the module, which FwProbeRead clears, and the address of its
+// realtime clock.
+//
+
+extern FW_SYSTEM FwSystemKn02;
+extern FW_SYSTEM FwSystemKn02Ba;
+extern FW_SYSTEM FwSystemKn03;
+
+PFW_SYSTEM FwSystemTable[] = {
+    &FwSystemKn02,
+    &FwSystemKn02Ba,
+    &FwSystemKn03
+};
+
+PFW_SYSTEM FwSystem;
+ULONG FwErrorRegister;
+ULONG FwRtcPhysicalBase;
+ULONG FwRexMemoryMap[REX_MEMORY_MAP_SIZE / sizeof(ULONG)];
+ULONG MemorySize;
+BOOLEAN KeyboardInitialized;
+BOOLEAN MctadrRev2;
=1 138 6
+VOID
+InitializePCR(
=1 187 4
=1 208 4
=1 2263 5
+    This routine is called by FwEntry.  It selects the description of the
+    system module, initializes the system parameter block, the master
+    processor boot status, the memory size and the PCR, and calls the boot
+    manager.
=1 219 3
+    Cause - Supplies the reset cause, zero.
+
+    Arg1 - Supplies the reset argument, zero.
=3 176 8
+    ULONG Bitmap;
+    ULONG Index;
+    ULONG Pages;
=1 244 1
+    ULONG SystemType;
+
+    //
+    // Select the description of the system module by the system type in
+    // the system identifier of the console.  On a module the firmware has
+    // no description of, print a message with the console printf service
+    // and return to the console prompt.
+    //
+
+    SystemType = (FwRexGetSystemId() >> REX_SYSID_SYSTEM_SHIFT) & REX_SYSID_FIELD_MASK;
+    for (Index = 0; Index < (sizeof(FwSystemTable) / sizeof(PFW_SYSTEM)); Index += 1) {
+        if (FwSystemTable[Index]->SystemType == SystemType) {
+            FwSystem = FwSystemTable[Index];
+            break;
=1 286 3
+    if (FwSystem == NULL) {
+        (*RexPrintf)("\nThe ARC firmware does not run on system type %d: it runs on\n", SystemType);
+        (*RexPrintf)("the DECstation 5000/1xx, 5000/200 and 5000/240.\n");
+        FwRexHalt();
+    }
+
+    FwErrorRegister = KSEG1_BASE | FwSystem->ErrorRegister;
+    FwRtcPhysicalBase = FwSystem->RtcPhysicalBase;
+
=1 305 1
+    SerialOutput = TRUE;
=1 307 1
+    MctadrRev2 = FALSE;
+
+    //
+    // Set the serial line of the console up before the first message.  The
+    // console can leave the transmitter of the line disabled (the console
+    // of the 5000/1xx does, when its own console is the screen), and a
+    // character written to a disabled transmitter stays in its buffer.
+    //
+
=3 309 2
+    //
+    // Initialize MemorySize to the size of memory in megabytes.  The console
+    // returns the bitmap of the memory it tested, one bit per page.
+    //
+
+    Pages = FwRexGetMemoryMap();
+    MemorySize = Pages >> (20 - PAGE_SHIFT);
=1 346 17
=1 372 3
=1 377 8
=1 544 2
+
=1 546 8
+    // Read the non-volatile configuration from the boot device.
+    //
+
+    FwNvramLoad();
+
+    FwPrintVersion();
+    InitializePCR();
=3 438 7
=1 286 3 -4
=1 2369 9
+     This routine prints the firmware version.
=1 2379 12
+    FwPrint(ST_ARC_MULTIBOOT_MSG, FW_VERSION);
=1 2392 4
+LONG
+FwRexBootRead (
+    IN ULONG Block,
+    OUT PVOID Buffer,
+    IN ULONG Length
=1 2262 6
+    This routine reads from the boot device with the console bootread
+    service.
=1 219 3
+    Block - Supplies the number of the first 512 byte block to read.
+
+    Buffer - Supplies the address of the buffer.
+
+    Length - Supplies the number of bytes to read.
=1 229 3
+    The number of bytes read, or a negative value if the read failed.
=1 2073 4
+    return (*RexBootRead)(Block, Buffer, Length);
+}
+
+LONG
+FwRexBootWrite (
+    IN ULONG Block,
+    IN PVOID Buffer,
+    IN ULONG Length
=1 2262 6
+    This routine writes to the boot device with the console bootwrite
+    service.
=1 219 3
+    Block - Supplies the number of the first 512 byte block to write.
+
+    Buffer - Supplies the address of the data.
+
+    Length - Supplies the length of the data in bytes.
=1 229 3
+    The number of bytes written, or a negative value if the write failed.
=1 2073 4
+    return (*RexBootWrite)(Block, Buffer, Length);
+}
+
+PCHAR
+FwRexGetEnvironment (
+    IN PCHAR Name
=1 2262 6
+    This routine returns the value of a console environment variable.
=1 219 3
+    Name - Supplies the name of the variable.
=1 229 3
+    A pointer to the value, or NULL if the variable is not defined.
=1 2073 4
+    return (*RexGetEnv)(Name);
+}
+
+ULONG
+FwRexGetSystemId (
=1 2261 7
+    This routine returns the console system identifier: the processor type
+    in bits 31-24, the system type in bits 23-16, the firmware revision in
+    bits 15-8 and the hardware revision in bits 7-0.
=1 658 7
+    The system identifier.
=1 2073 4
+    return (*RexGetSysId)();
+}
+
+ULONG
+FwRexGetMemoryMap (
=1 2261 7
+    This routine reads the memory map of the console into FwRexMemoryMap:
+    the size of a page in bytes, followed by one bit for each page that the
+    console found good, and counts the good pages from page zero up to the
+    first page that is not good.
+
+    N.B. The length that the console returns is the length of its map, which
+         can describe more pages than memory has (gxemul returns the length
+         of a map for 480mb): the bits tell where memory ends.
=1 658 7
+    The number of good pages from page zero.
=1 2073 4
+    PUCHAR Bitmap;
+    LONG Index;
+    LONG Length;
+    ULONG Pages;
+
+    Length = (*RexGetBitMap)(FwRexMemoryMap);
+    if ((Length <= 0) || (Length > (REX_MEMORY_MAP_SIZE - 4))) {
+        return 0;
+    }
+
+    Bitmap = (PUCHAR)&FwRexMemoryMap[1];
+    Pages = 0;
+    for (Index = 0; Index < Length; Index += 1) {
+        if (Bitmap[Index] != 0xff) {
+            while ((Bitmap[Index] & (1 << (Pages & 7))) != 0) {
+                Pages += 1;
+            }
+
=2 154 3 4
+        Pages += 8;
+    }
+
+    return Pages;
+}
+
+VOID
+FwRexHalt (
=1 2261 7
+    This routine returns to the console prompt with the console command
+    service, command 'h'.  The firmware calls it when it cannot run, before
+    it invokes any program.
=1 658 7
+    Does not return.
=1 2073 4
+    (*ccv->_reboot)(REX_COMMAND_HALT);
+}
+
+VOID
+FwRexSavePageZero (
=1 2261 7
+    This routine is called before the firmware invokes a loaded program.  It
+    copies page zero, which holds the work area of the console, to
+    FwRexPageZero: the system that the program starts can take the page,
+    the exception page of a MIPS system, and FwRexRelease puts the copy
+    back before the console gets control again.
+
+    The page is read through KSEG1: the console writes its work area
+    uncached.
=1 658 10
+
+{
+    ULONG Index;
+    PULONG PageZero;
+
+    PageZero = (PULONG)KSEG1_BASE;
+    for (Index = 0; Index < (PAGE_SIZE / sizeof(ULONG)); Index += 1) {
+        FwRexPageZero[Index] = PageZero[Index];
+    }
+
+    FwRexPageZeroSaved = TRUE;
+}
+
+VOID
+FwRexResetScsiBus (
=1 2261 7
+    This routine gives the SCSI bus of the system module back to the boot
+    driver of the console after a loaded program ran.  The SCSI driver of
+    the system that the program started negotiates synchronous transfers
+    with the devices, which keep them until the bus is reset, and it leaves
+    the synchronous offset of the last device it selected in the protocol
+    chip.  The boot driver of the console sends no messages and transfers
+    asynchronously, as its power-up initialization set the chip, and it
+    starts a transfer with the chip as it finds it.
+
+    So the routine sets the chip to asynchronous transfers and resets the
+    bus, which returns every device to asynchronous transfers and ends what
+    a device still had in progress, waits the reset to selection time, and
+    clears the reset interrupt of the chip.  The first command a device
+    gets after the reset reports the reset (unit attention), so the caller
+    tries a failed write again.  The status and the interrupt register of
+    the chip after the reset are shown on the console.
=1 658 10
+
+{
+    UCHAR Interrupt;
+    PSCSI_REGISTERS ScsiRegisters;
+    UCHAR Status;
+
+    ScsiRegisters = (PSCSI_REGISTERS)(KSEG1_BASE | FwSystem->ScsiPhysicalBase);
+    SCSI_WRITE(ScsiRegisters, SynchronousOffset, 0);
+    SCSI_WRITE(ScsiRegisters, Command, FLUSH_FIFO);
+    SCSI_WRITE(ScsiRegisters, Command, RESET_SCSI_BUS);
+    FwStallExecution(REX_SCSI_RESET_DELAY);
+
+    //
+    // Read the status, then the interrupt register, which clears the
+    // interrupt.
+    //
+
+    Status = SCSI_READ(ScsiRegisters, ScsiStatus);
+    Interrupt = SCSI_READ(ScsiRegisters, ScsiInterrupt);
+    SCSI_WRITE(ScsiRegisters, Command, FLUSH_FIFO);
+    FwPrint(FW_REX_SCSI_RESET_MSG, Status, Interrupt);
=1 2393 3
+VOID
+FwRexStopEthernet (
=1 2261 7
+    This routine stops the LANCE of the system slot of the 5000/1xx and the
+    5000/240 after a loaded program ran.  The LANCE moves the frames it
+    receives into memory through the Ethernet channel of the IO Control
+    ASIC, and the network driver of the system that the program started
+    leaves it receiving into the memory of the system, which the console
+    takes again for its work and for the boot program it loads.  So the
+    routine clears the enables of the LANCE and of its DMA in the system
+    support register of the ASIC, which holds the LANCE in reset, as at
+    power-up.
+
+    The LANCE of the PMAD-AA of the 5000/200 keeps its frames in the memory
+    of the module, and the routine leaves it as it is.
=1 658 10
+
+{
+    volatile ULONG *SystemSupport;
+
+    if (FwSystem->SystemSupportRegister != 0) {
+        SystemSupport =
+            (volatile ULONG *)(KSEG1_BASE | FwSystem->SystemSupportRegister);
+
+        *SystemSupport &= ~FwSystem->EthernetEnable;
+    }
+
=1 2393 3
+VOID
+FwRexRelease (
+    IN ULONG Command
=1 2262 6
+    This routine gives the machine back to the console.  FwRexReturnToConsole
+    calls it on the firmware stack, with interrupts disabled and the
+    exceptions on the bootstrap vectors of the console.
+
+    If the firmware invoked a program, the routine first stops the LANCE
+    of the system slot (FwRexStopEthernet), which the system's network
+    driver leaves receiving into memory, then puts back page zero as it
+    was then: the system that the program started has kept its exception
+    vectors, its first processor control block and its idle thread in the
+    page, over the work area of the console, and the boot write service
+    of the console, which writes the non-volatile configuration, would
+    take its own data from the page.  The page is written through KSEG1,
+    then both caches are swept, so no cached line of the system's page is
+    left.  The serial line of the firmware console is set up again, as
+    the system's serial drivers can have changed it, and each step from
+    there on is shown on it, so a terminal on the line shows how far the
+    return to the console got.  The SCSI bus is reset, so the devices the
+    system's SCSI driver left in synchronous transfers return to the
+    asynchronous transfers of the console's boot driver.
+
+    Then the non-volatile configuration is written, if a loaded program,
+    or the system it started, changed it, and the console command service
+    restarts the system the way the console boot action does (command
+    'b'), or returns to the console prompt (command 'h'), once the serial
+    line has sent the last message.
=1 219 3
+    Command - Supplies the console command, REX_COMMAND_BOOT or
+        REX_COMMAND_HALT.
=1 229 3
+    Does not return.
=1 2073 4
+    ULONG Index;
+    PULONG PageZero;
+
+    if (FwRexPageZeroSaved != FALSE) {
+        FwRexStopEthernet();
+        PageZero = (PULONG)KSEG1_BASE;
+        for (Index = 0; Index < (PAGE_SIZE / sizeof(ULONG)); Index += 1) {
+            PageZero[Index] = FwRexPageZero[Index];
+        }
+
+        HalSweepDcache();
+        HalSweepIcache();
+        SerialConsoleSetup();
+        FwPrint(FW_REX_RETURN_MSG);
+        FwRexResetScsiBus();
+    }
+
+    FwNvramRelease();
+    if (Command == REX_COMMAND_BOOT) {
+        FwPrint(FW_REX_BOOT_MSG);
+    } else {
+        FwPrint(FW_REX_HALT_MSG);
+    }
+
+    SerialConsoleDrain();
+    (*ccv->_reboot)(Command);
+    for (;;) {
+    }
+}
