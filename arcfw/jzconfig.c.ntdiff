+#if defined(DECSTATION)
+
+BOOLEAN
+FwGetTurboChannelModule (
+    IN ULONG Slot,
+    OUT PCHAR ModuleName
=1 45 6
+    This routine reads the module name from the option ROM of a TURBOchannel
+    slot.  The header of the ROM is at the start of the slot or at the offset
+    of the prototype ROM: a header has a width of 1, 2 or 4, a stride of 4
+    and the test pattern.  The slot is read with FwProbeRead, as a read from
+    an empty slot takes a bus error.
=1 52 3
+    Slot - Supplies the number of the slot.
+
+    ModuleName - Supplies a pointer to a buffer of
+        TURBOCHANNEL_MODULE_NAME_LENGTH + 1 characters that receives the
+        module name, without the blanks at its end.
=1 56 3
+    TRUE if the slot has an option ROM, otherwise FALSE.
=3 166 4
+    static UCHAR TestPattern[] = { 0x55, 0x00, 0xaa, 0xff };
+    static ULONG RomOffset[] = { TURBOCHANNEL_ROM_OFFSET,
+                                 TURBOCHANNEL_PROTOTYPE_ROM_OFFSET };
+    ULONG Index;
+    ULONG Offset;
+    PUCHAR Rom;
+    ULONG Value;
+
+    for (Offset = 0; Offset < 2; Offset += 1) {
+        Rom = (PUCHAR)(KSEG1_BASE |
+                       (TURBOCHANNEL_SLOT_PHYSICAL_BASE(Slot) + RomOffset[Offset]));
+
+        //
+        // Check the width and the stride of the ROM and the test pattern.
+        //
+
+        if (!FwProbeRead((PULONG)(Rom + TURBOCHANNEL_ROM_WIDTH), &Value) ||
+            (((Value & 0xff) != 1) && ((Value & 0xff) != 2) && ((Value & 0xff) != 4)) ||
+            !FwProbeRead((PULONG)(Rom + TURBOCHANNEL_ROM_STRIDE), &Value) ||
+            ((Value & 0xff) != 4)) {
=3 490 3 -4
+        for (Index = 0; Index < sizeof(TestPattern); Index += 1) {
+            if (!FwProbeRead((PULONG)(Rom + TURBOCHANNEL_ROM_TEST + (Index * 4)), &Value) ||
+                ((Value & 0xff) != TestPattern[Index])) {
=3 476 4 -4
+        if (Index != sizeof(TestPattern)) {
=3 516 4 -4
+        // Read the module name and remove the blanks at its end.
+        //
+
+        for (Index = 0; Index < TURBOCHANNEL_MODULE_NAME_LENGTH; Index += 1) {
+            if (!FwProbeRead((PULONG)(Rom + TURBOCHANNEL_ROM_MODULE_NAME + (Index * 4)), &Value)) {
=1 316 3 8
+            ModuleName[Index] = (CHAR)Value;
+        }
+
+        if (Index != TURBOCHANNEL_MODULE_NAME_LENGTH) {
=3 490 3 -4
+        while ((Index != 0) && (ModuleName[Index - 1] == ' ')) {
+            Index -= 1;
+        }
+
+        ModuleName[Index] = 0;
+        return TRUE;
+    }
+
+    return FALSE;
+}
